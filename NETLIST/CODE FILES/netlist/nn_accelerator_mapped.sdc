set_load -pin_load 0.01 [get_ports {data_out[1]}]
set_load -pin_load 0.01 [get_ports {data_out[0]}]
set_load -pin_load 0.01 [get_ports busy]
set_load -pin_load 0.01 [get_ports done]
set_clock_gating_check -setup 0.0 
set_input_delay -clock [get_clocks clk] -add_delay -max 2.0 [get_ports resetn]
set_input_delay -clock [get_clocks clk] -add_delay -max 2.0 [get_ports wr_en]
set_input_delay -clock [get_clocks clk] -add_delay -max 2.0 [get_ports {addr[5]}]
